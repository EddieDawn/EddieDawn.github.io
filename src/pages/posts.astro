---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="TIL | Eddie's TIL" description="Eddie가 기록한 개발 학습 노트 목록입니다.">
  <section class="max-w-3xl space-y-4">
    <p class="text-sm font-semibold tracking-wide text-[#7a5c54]">TIL</p>
    <h1 class="text-3xl font-bold tracking-tight text-stone-800">학습 기록</h1>
    <p class="leading-7 text-stone-600">글 콘텐츠 기능을 구현하면 이곳에 최신 학습 기록이 표시됩니다.</p>
  </section>
</BaseLayout>
