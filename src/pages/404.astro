---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="페이지를 찾을 수 없습니다 | Eddie's TIL">
  <section class="max-w-xl space-y-5">
    <p class="text-sm font-semibold tracking-wide text-[#7a5c54]">404</p>
    <h1 class="text-3xl font-bold tracking-tight text-stone-800">페이지를 찾을 수 없습니다.</h1>
    <p class="leading-7 text-stone-600">주소가 잘못되었거나 페이지가 이동했을 수 있습니다.</p>
    <a class="font-semibold text-[#7a5c54] underline underline-offset-4 hover:text-[#624841]" href="/">홈으로 돌아가기</a>
  </section>
</BaseLayout>
