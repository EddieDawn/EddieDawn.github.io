---
import { categories } from "../config/categories";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Eddie's TIL | 오늘 배운 것을 기록합니다">
  <section class="max-w-3xl">
    <p class="text-sm font-semibold tracking-wide text-[#7a5c54]">
      DEVELOPER TIL
    </p>
    <p class="mt-6 max-w-2xl font-bold text-lg leading-8 text-stone-600">
      관심 있는 주제를 선택해 학습 기록을 살펴보세요.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="category-heading">
    <div
      class="flex items-baseline justify-between border-b border-stone-300/80 pb-4"
    >
      <h2 id="category-heading" class="text-xl font-bold text-stone-800">
        Categories
      </h2>
      <p class="text-xs text-stone-500">3 topics</p>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        categories.map((category) => (
          <li>
            <a
              class="group flex min-h-44 flex-col justify-between rounded-md border border-stone-300/80 bg-[#f6f3ee] p-5 shadow-sm transition hover:-translate-y-1 hover:border-stone-400 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#7a5c54]"
              href={`/categories/${category.slug}`}
            >
              <span
                class="h-1 w-10 rounded-full"
                style={`background-color: ${category.accent}`}
              />
              <div class="mt-8">
                <h3 class="text-lg font-bold text-stone-800 group-hover:text-[#7a5c54]">
                  {category.name}
                </h3>
                <p class="mt-3 text-sm leading-6 text-stone-600">
                  {category.description}
                </p>
              </div>
              <span class="mt-5 text-sm font-semibold text-stone-500 group-hover:text-[#7a5c54]">
                기록 보기 →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
