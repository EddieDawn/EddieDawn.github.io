  instagram: "M7 2h10c2.76 0 5 2.24 5 5v10c0 2.76-2.24 5-5 5H7c-2.76 0-5-2.24-5-5V7c0-2.76 2.24-5 5-5Zm-.16 2A2.84 2.84 0 0 0 4 6.84v10.32A2.84 2.84 0 0 0 6.84 20h10.32A2.84 2.84 0 0 0 20 17.16V6.84A2.84 2.84 0 0 0 17.16 4H6.84ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.4-3.5a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z",
  email: "M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13Zm2 .18v.26l6.37 5.1a1 1 0 0 0 1.26 0L19 5.94v-.26a.5.5 0 0 0-.5-.5h-13a.5.5 0 0 0-.5.5ZM19 8.5l-5.12 4.1a3 3 0 0 1-3.76 0L5 8.5v10a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-10Z",
} as const;
---

<aside class="w-full border-b border-stone-300/80 pb-8 lg:sticky lg:top-10 lg:w-60 lg:self-start lg:border-r lg:border-b-0 lg:pb-0 lg:pr-10">
  <div class="flex items-center gap-5 lg:block">
    <img class="size-20 rounded-full border-4 border-[#e7ddd4] object-cover shadow-sm lg:size-28" src={site.profileImage} alt={`${site.name}의 프로필 사진`} width="240" height="240" />
    <div class="space-y-1 pt-0 lg:pt-5">
      <h2 class="text-lg font-bold text-stone-800">{site.name}</h2>
      <p class="text-sm leading-6 text-stone-600">{site.bio}</p>
    </div>
  </div>
  <div class="mt-6 space-y-3 text-sm text-stone-600">
    <p class="flex items-center gap-2"><span aria-hidden="true">⌖</span>{site.location}</p>
    <ul class="space-y-2" aria-label="프로필 링크">
      {site.links.map(({ label, href, icon }) => (
        <li>
          <a class="inline-flex items-center gap-1.5 hover:text-[#7a5c54] hover:underline hover:underline-offset-4" href={href} target={icon === "email" ? undefined : "_blank"} rel={icon === "email" ? undefined : "noreferrer"}>
            <svg class="size-3.5" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={icons[icon]} /></svg>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>
