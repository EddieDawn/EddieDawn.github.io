---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const publishedAt = post.data.publishedAt.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="rounded-md border border-stone-300/80 bg-[#f6f3ee] p-5 shadow-sm transition hover:border-stone-400 hover:shadow-md">
  <a class="block" href={`/posts/${post.id}`}>
    <p class="text-xs font-semibold uppercase tracking-wide text-[#7a5c54]">{post.data.category}</p>
    <h2 class="mt-3 text-lg font-bold leading-7 text-stone-800 hover:text-[#7a5c54]">{post.data.title}</h2>
    <p class="mt-3 text-sm leading-6 text-stone-600">{post.data.description}</p>
    <div class="mt-5 flex items-center justify-between gap-3 text-xs text-stone-600">
      <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
      <span aria-hidden="true">→</span>
    </div>
  </a>
</article>
